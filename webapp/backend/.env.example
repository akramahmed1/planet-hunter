# Names only. Real values live in Railway variables, never in git.
# Comma-separated extra CORS origins (the frontend URL for that environment).
ALLOWED_ORIGINS=
# Postgres for /api/v2 (Railway Postgres reference). v1 endpoints never use it.
DATABASE_URL=
# api.nasa.gov key for APOD and DONKI (Phase 2).
NASA_API_KEY=
# Tests only: a disposable Postgres. REQUIRE_DB=1 makes DB tests fail instead of skip.
TEST_DATABASE_URL=
REQUIRE_DB=
