{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/candidates",
        "http://127.0.0.1:3000/learn",
        "http://127.0.0.1:3000/solar-system"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless=new", "formFactor": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.6 }],
        "total-byte-weight": ["error", { "maxNumericValue": 2500000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-report" }
  }
}
